        .margin({ bottom: this.breakpoint === 'sm' ? 24 : 32 })

        // Config section - responsive layout
        Flex({ wrap: FlexWrap.Wrap, justifyContent: FlexAlign.SpaceBetween }) {
          // Device Name
          Column() {
            Text('è®¾å¤‡åç§°')
              .fontSize(12)
              .fontColor('#666666')
              .alignSelf(ItemAlign.Start)
              .margin({ bottom: 6 })

            TextInput({ text: this.deviceName, placeholder: 'è¾“å…¥è®¾å¤‡åç§°' })
              .fontSize(15)
              .fontColor('#ffffff')
              .backgroundColor('rgba(255,255,255,0.06)')
              .borderRadius(10)
              .border({ width: 1, color: 'rgba(255,255,255,0.15)' })
              .padding(12)
              .width(this.breakpoint === 'sm' ? '100%' : '100%')
              .onChange((value: string) => { this.deviceName = value; })
          }
          .width(this.breakpoint === 'sm' ? '100%' : '48%')
          .margin({ bottom: 14 })

          // Server IP
          Column() {
            Text('æœåŠ¡å™¨åœ°å€ï¼ˆè¿è¡Œ start.bat çš„ç”µè„‘IPï¼‰')
              .fontSize(12)
              .fontColor('#666666')
              .alignSelf(ItemAlign.Start)
              .margin({ bottom: 6 })

            Row() {
              TextInput({ text: this.serverIp, placeholder: '192.168.x.x' })
                .fontSize(15)
                .fontColor('#ffffff')
                .backgroundColor('rgba(255,255,255,0.06)')
                .borderRadius(10)
                .border({ width: 1, color: 'rgba(255,255,255,0.15)' })
                .padding(12)
                .layoutWeight(1)
                .onChange((value: string) => { this.serverIp = value; })

              Text(':')
                .fontSize(16)
                .fontColor('#888888')
                .margin({ left: 6, right: 6 })

              TextInput({ text: this.serverPort, placeholder: '3000' })
                .fontSize(15)
                .fontColor('#ffffff')
                .backgroundColor('rgba(255,255,255,0.06)')
                .borderRadius(10)
                .border({ width: 1, color: 'rgba(255,255,255,0.15)' })
                .padding(12)
                .width(72)
                .type(InputType.Number)
                .onChange((value: string) => { this.serverPort = value; })
            }
            .width('100%')
          }
          .width(this.breakpoint === 'sm' ? '100%' : '48%')
          .margin({ bottom: 14 })
        }
        .width('100%')
        .margin({ bottom: this.breakpoint === 'sm' ? 28 : 36 })

        Button(this.connecting ? 'è¿æ¥ä¸­...' : 'å¼€å§‹ä½¿ç”¨')
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor('#000000')
          .backgroundColor('#4facfe')
          .borderRadius(12)
          .width('100%')
          .height(52)
          .enabled(!this.connecting)
          .onClick(() => { this.saveAndConnect(); })

        Text('æç¤ºï¼šè¯·å…ˆåœ¨ç”µè„‘ä¸Šè¿è¡Œ start.bat å¯åŠ¨æœåŠ¡å™¨')
          .fontSize(11)
          .fontColor('#555555')
          .margin({ top: 16 })
          .textAlign(TextAlign.Center)
      }
      .width(this.breakpoint === 'sm' ? '86%' : (this.breakpoint === 'md' ? '70%' : '50%'))
      .constraintSize({ maxWidth: 560 })
      .alignItems(HorizontalAlign.Center)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Center)
    .backgroundColor('#0a0a0a')
  }
}
