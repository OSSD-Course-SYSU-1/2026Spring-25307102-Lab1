import webview from '@ohos.web.webview';

interface RouterParams {
  serverUrl: string;
  deviceName: string;
}

@Entry
@Component
struct TransferPage {
  @State serverUrl: string = '';
  @State deviceName: string = '';
  @State progress: number = 0;
  @State showError: boolean = false;
  private controller: webview.WebviewController = new webview.WebviewController();

  aboutToAppear(): void {
    let params = router.getParams() as RouterParams;
    if (params) {
      this.serverUrl = params.serverUrl;
      this.deviceName = params.deviceName;
    }
  }

  onPageShow(): void {
    // é¡µé¢æ˜¾ç¤ºæ—¶æ— éœ€æ‰‹åŠ¨å»¶æ—¶æ³¨å…¥ï¼ŒonPageEnd å›žè°ƒä¼šå¤„ç†
  }

  updateDeviceName(): void {
    // ä½¿ç”¨ JSON.stringify å®‰å…¨è½¬ä¹‰è®¾å¤‡åç§°ï¼Œé˜²æ­¢ç‰¹æ®Šå­—ç¬¦ç ´å JS è¯­æ³•
    let safeName = JSON.stringify(this.deviceName);
    let script = `(function(){ var el = document.getElementById('dev-name'); if (el) el.value = ${safeName}; })();`;
    this.controller.runJavaScript(script);
  }

  build() {
    Column() {
      if (this.showError) {
        Column() {
          Text('æ— æ³•è¿žæŽ¥')
            .fontSize(18)
            .fontColor('#ff5252')
            .margin({ bottom: 12 })

          Text('è¯·æ£€æŸ¥ï¼š')
            .fontSize(13)
            .fontColor('#888888')

          Text('1. æœåŠ¡å™¨å·²å¯åŠ¨')
            .fontSize(13)
            .fontColor('#666666')
            .margin({ top: 8 })

          Text('2. è®¾å¤‡åœ¨åŒä¸€ WiFi')
            .fontSize(13)
            .fontColor('#666666')
            .margin({ top: 4 })

          Text('3. é˜²ç«å¢™å·²å¼€æ”¾ 3000 ç«¯å£')
            .fontSize(13)
            .fontColor('#666666')
            .margin({ top: 4 })

          Text(`å½“å‰åœ°å€: ${this.serverUrl}`)
            .fontSize(11)
            .fontColor('#555555')
            .margin({ top: 16, bottom: 24 })

          Button('è¿”å›žä¿®æ”¹')
            .fontSize(14)
            .fontColor('#ffffff')
            .backgroundColor('rgba(255,255,255,0.1)')
            .border({ width: 1, color: 'rgba(255,255,255,0.2)' })
            .borderRadius(10)
            .padding({ left: 24, right: 24, top: 10, bottom: 10 })
            .onClick(() => { router.back(); })
        }
        .width('100%')
        .height('100%')
        .justifyContent(FlexAlign.Center)
        .alignItems(HorizontalAlign.Center)
        .backgroundColor('#0a0a0a')
      } else {
        Stack() {
          Web({ src: this.serverUrl, controller: this.controller })
            .width('100%')
            .height('100%')
            .javaScriptAccess(true)
            .domStorageAccess(true)
            .fileAccess(true)
            .onlineImageAccess(true)
            .zoomAccess(false)
            .onProgressChange((event) => {
              if (event) this.progress = event.newProgress;
            })
            .onErrorReceive((event) => {
              console.error('Web error: ' + (event?.error?.getErrorInfo?.() || ''));
              this.showError = true;
            })
            .onPageEnd(() => {
              this.progress = 100;
              setTimeout(() => { this.updateDeviceName(); }, 500);
            })

          if (this.progress < 100) {
            Column() {
              LoadingProgress()
                .color('#4facfe')
                .width(40)
                .height(40)
              Text(`${this.progress}%`)
                .fontSize(12)
                .fontColor('#888888')
                .margin({ top: 12 })
            }
            .width('100%')
            .height('100%')
            .justifyContent(FlexAlign.Center)
            .alignItems(HorizontalAlign.Center)
          }
        }
        .width('100%')
        .height('100%')
        .backgroundColor('#0a0a0a')
      }
    }
    .width('100%')
    .height('100%')
  }
}
