/**
 * @brief æ ¹æ®æ¨¡å‹ç±»å‹è·å–å¯¹åº”çš„å‚æ•°æè¿°åˆ—è¡¨
 *
 * ä¸åŒæ›²é¢çš„å‚æ•°å«ä¹‰ä¸åŒï¼š
 *   - æ¤­çƒé¢ï¼ša/b/c ä¸ºä¸‰ä¸ªåŠè½´é•¿åº¦
 *   - åŒæ›²é¢ï¼ša/b/c ä¸ºæ–¹ç¨‹ç³»æ•°
 *   - æŠ›ç‰©é¢ï¼ša/b æ§åˆ¶å¼€å£å½¢çŠ¶ï¼Œc æ§åˆ¶ z è½´ç¼©æ”¾
 *   - æ¤­åœ†é”¥é¢ï¼ša/b æ§åˆ¶åº•é¢æ¤­åœ†ï¼Œc æ§åˆ¶é”¥ä½“é«˜åº¦
 */
export function getParamDescriptions(shapeType: ShapeType): ParamDescription[] {
  switch (shapeType) {
    case ShapeType.PARAMETRIC_ELLIPSOID:
      return [
        { key: 'paramA', label: 'åŠé•¿è½´ a (xæ–¹å‘)', min: 0.3, max: 3.0, step: 0.1, defaultValue: 1.5 },
        { key: 'paramB', label: 'åŠé•¿è½´ b (yæ–¹å‘)', min: 0.3, max: 3.0, step: 0.1, defaultValue: 1.2 },
        { key: 'paramC', label: 'åŠé•¿è½´ c (zæ–¹å‘)', min: 0.3, max: 3.0, step: 0.1, defaultValue: 1.0 },
        { key: 'resolutionU', label: 'ç»åº¦åˆ†è¾¨ç‡', min: 8, max: 64, step: 4, defaultValue: 32 },
        { key: 'resolutionV', label: 'çº¬åº¦åˆ†è¾¨ç‡', min: 8, max: 64, step: 4, defaultValue: 32 },
      ];
    case ShapeType.PARAMETRIC_HYPERBOLOID:
      return [
        { key: 'paramA', label: 'å‚æ•° a', min: 0.3, max: 2.5, step: 0.1, defaultValue: 1.0 },
        { key: 'paramB', label: 'å‚æ•° b', min: 0.3, max: 2.5, step: 0.1, defaultValue: 1.0 },
        { key: 'paramC', label: 'å‚æ•° c (è…°çš„ç²—ç»†)', min: 0.3, max: 2.0, step: 0.1, defaultValue: 0.8 },
        { key: 'resolutionU', label: 'ç¯å‘åˆ†è¾¨ç‡', min: 8, max: 64, step: 4, defaultValue: 32 },
        { key: 'resolutionV', label: 'çºµå‘åˆ†è¾¨ç‡', min: 8, max: 64, step: 4, defaultValue: 32 },
      ];
    case ShapeType.PARAMETRIC_PARABOLOID:
      return [
        { key: 'paramA', label: 'å‚æ•° a', min: 0.3, max: 2.0, step: 0.1, defaultValue: 0.8 },
        { key: 'paramB', label: 'å‚æ•° b', min: 0.3, max: 2.0, step: 0.1, defaultValue: 0.8 },
        { key: 'paramC', label: 'zè½´ç¼©æ”¾', min: 0.2, max: 1.5, step: 0.1, defaultValue: 0.6 },
        { key: 'resolutionU', label: 'ç¯å‘åˆ†è¾¨ç‡', min: 8, max: 64, step: 4, defaultValue: 32 },
        { key: 'resolutionV', label: 'å¾„å‘åˆ†è¾¨ç‡', min: 8, max: 64, step: 4, defaultValue: 32 },
      ];
    case ShapeType.PARAMETRIC_ELLIPTIC_CONE:
      return [
        { key: 'paramA', label: 'å‚æ•° a', min: 0.2, max: 2.0, step: 0.1, defaultValue: 0.7 },
        { key: 'paramB', label: 'å‚æ•° b', min: 0.2, max: 2.0, step: 0.1, defaultValue: 0.7 },
        { key: 'paramC', label: 'å‚æ•° c', min: 0.2, max: 2.0, step: 0.1, defaultValue: 0.7 },
        { key: 'resolutionU', label: 'ç¯å‘åˆ†è¾¨ç‡', min: 8, max: 64, step: 4, defaultValue: 32 },
        { key: 'resolutionV', label: 'çºµå‘åˆ†è¾¨ç‡', min: 8, max: 64, step: 4, defaultValue: 32 },
      ];
    default:
      return [];
  }
}
