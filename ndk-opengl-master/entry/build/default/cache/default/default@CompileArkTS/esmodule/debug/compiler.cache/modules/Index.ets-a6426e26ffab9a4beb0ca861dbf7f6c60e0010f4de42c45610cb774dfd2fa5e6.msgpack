 *   - æ‰‹åŠ¿æ‹–æ‹½ï¼šæ—‹è½¬æ¨¡å‹ï¼ˆPanGestureï¼‰
 *   - è‡ªåŠ¨æ—‹è½¬ï¼šæ¨¡å‹ç»• Y è½´åŒ€é€Ÿæ—‹è½¬
 *   - é˜»å°¼æ—‹è½¬ï¼šæ‰‹åŠ¿é‡Šæ”¾åæƒ¯æ€§å‡é€Ÿ
 *   - ç¼©æ”¾æ»‘å—ï¼šè°ƒèŠ‚æ¨¡å‹æ˜¾ç¤ºå¤§å°
 *   - æ¨¡å‹æŒ‰é’®ï¼šè¿›å…¥æ¨¡å‹é€‰æ‹©é¡µé¢
 *
 * NAPI é€šä¿¡ï¼š
 *   tetrahedron_napi.updateAngle(x, y)  â†’ æ›´æ–°æ—‹è½¬è§’åº¦
 *   tetrahedron_napi.setRotate(mode)    â†’ è®¾ç½®æ—‹è½¬æ¨¡å¼
 *   tetrahedron_napi.selectShape(type)  â†’ åˆ‡æ¢æ¨¡å‹
 *   tetrahedron_napi.setShapeParams(p)  â†’ è®¾ç½®è‡ªå®šä¹‰å‚æ•°
 *   tetrahedron_napi.setScale(s)        â†’ è®¾ç½®ç¼©æ”¾
 */

import { LengthMetrics, window, router } from '@kit.ArkUI';
import { hilog } from '@kit.PerformanceAnalysisKit';
import { Logger } from '../utils/Logger';
import tetrahedron_napi from 'libtetrahedron_napi.so';
import { RotationType } from '../utils/Constants';
import { ShapeType, ShapeParams } from '../utils/ModelTypes';

/** å®‰å…¨åŒºåŸŸæ•°æ®ç»“æ„ */
interface Areas {
  top: number,
  right: number,
  bottom: number,
  left: number,
  heightBreakpoint: number,
  widthBreakpoint: number
}

/** ä»æ¨¡å‹é€‰æ‹©/å‚æ•°ç¼–è¾‘é¡µé¢è¿”å›çš„è·¯ç”±å‚æ•° */
interface RouteResult {
  shapeType: number;           // ShapeType æšä¸¾å€¼
  shapeParams: ShapeParams | null; // è‡ªå®šä¹‰å‚æ•°ï¼ˆåŸºç¡€æ¨¡å‹ä¸º nullï¼‰
}

// ============================================================================
// å®‰å…¨åŒºåŸŸè®¡ç®—è¾…åŠ©å‡½æ•°
// ============================================================================

/** è·å–é¡¶éƒ¨å®‰å…¨åŒºåŸŸé«˜åº¦ï¼ˆåˆ˜æµ·/çŠ¶æ€æ ï¼‰ */
function getTop(avoidArea: window.AvoidAreaOptions | undefined): number {
  let result: number = 0;
  if (avoidArea !== undefined) {
    if (avoidArea.area.topRect.height) {
      result = avoidArea.area.topRect.top + avoidArea.area.topRect.height;
    }
  } else {
    hilog.error(0x0000, '3D', 'Can not get TopSafeAreaPixel, avoidArea visible false');
  }
  return result;
}

/** è·å–åº•éƒ¨å®‰å…¨åŒºåŸŸé«˜åº¦ï¼ˆå¯¼èˆªæ ï¼‰ */
function getBottom(avoidArea: window.AvoidAreaOptions | undefined, windowHeight: number): number {
  let result: number = 0;
  if (avoidArea !== undefined) {
    if (avoidArea.area.bottomRect.height) {
      result = windowHeight - avoidArea.area.bottomRect.top;
    }
  } else {
    hilog.error(0x0000, '3D', 'Can not get BottomSafeAreaPixel, avoidArea visible false');
  }
  return result;
}

/** è·å–å·¦ä¾§å®‰å…¨åŒºåŸŸå®½åº¦ */
function getLeft(avoidArea: window.AvoidAreaOptions | undefined): number {
  let result: number = 0;
  if (avoidArea !== undefined) {
    if (avoidArea.area.leftRect.width) {
      result = avoidArea.area.leftRect.left + avoidArea.area.leftRect.width;
    }
  } else {
    hilog.error(0x0000, '3D', 'Can not get LeftSafeAreaPixel, avoidArea visible false');
  }
  return result;
}

/** è·å–å³ä¾§å®‰å…¨åŒºåŸŸå®½åº¦ */
function getRight(avoidArea: window.AvoidAreaOptions | undefined, windowWidth: number): number {
  let result: number = 0;
  if (avoidArea !== undefined) {
    if (avoidArea.area.rightRect.width) {
      result = windowWidth - avoidArea.area.rightRect.left;
    }
  } else {
    hilog.error(0x0000, '3D', 'Can not get RightSafeAreaPixel, avoidArea visible false');
  }
  return result;
}

@Entry
@Component
struct Index {
  // ========================= æ¸²æŸ“çŠ¶æ€ =========================
  /** å½“å‰æ—‹è½¬è§’åº¦æ•°ç»„ [angleX, angleY] */
  @State angleArray: Array<number> = new Array<number>();
  /** è‡ªåŠ¨æ—‹è½¬å¼€å…³çŠ¶æ€ */
  @State enableRotate: boolean = false;
  /** å½“å‰æ¨¡å‹ä¸­æ–‡åç§°ï¼ˆæ˜¾ç¤ºåœ¨å·¦ä¸Šè§’ï¼‰ */
  @State currentShapeName: string = 'å››é¢ä½“';
  /** æ¨¡å‹ç¼©æ”¾æ¯”ä¾‹ (0.3 ~ 2.5) */
  @State modelScale: number = 1.0;

  // ========================= å®‰å…¨åŒºåŸŸ =========================
  @State cutoutAreas: Areas = {
    top: 0, right: 0, bottom: 0, left: 0,
    heightBreakpoint: 0, widthBreakpoint: 0
  };

  @State localPadding: LocalizedPadding = {
    top: LengthMetrics.vp(0),
    start: LengthMetrics.vp(0)
  };

  // ========================= å“åº”å¼æ–­ç‚¹ =========================
  /** ç›‘å¬é«˜åº¦æ–­ç‚¹å˜åŒ–ï¼Œè§¦å‘é‡æ–°è®¡ç®—å®‰å…¨åŒºåŸŸ */
  @StorageLink('currentHeightBreakpoint') @Watch('breakPointChange')
  heightBreakpoint: HeightBreakpoint = HeightBreakpoint.HEIGHT_SM;
  /** ç›‘å¬å®½åº¦æ–­ç‚¹å˜åŒ– */
  @StorageLink('currentWidthBreakpoint') @Watch('breakPointChange')
  widthBreakpoint: WidthBreakpoint = WidthBreakpoint.WIDTH_XS;

  /** ç›‘å¬åˆ˜æµ·/å®‰å…¨åŒºåŸŸå˜åŒ– */
  @StorageLink('cutout') @Watch('cutoutChange')
  avoidAreas: window.AvoidAreaOptions | undefined = undefined;
  @StorageLink('windowHeight') windowHeight: number = 0;
  @StorageLink('windowWidth') windowWidth: number = 0;

  // ========================= ç»„ä»¶æ ‡è¯† =========================
  private xComponentId = 'tetrahedron';
  /** æ‰‹åŠ¿é…ç½®ï¼šæ”¯æŒå…¨æ–¹å‘æ‹–æ‹½ */
  private panOption: PanGestureOptions = new PanGestureOptions({ direction: PanDirection.All });

  // ==========================================================================
  // æ–­ç‚¹å˜åŒ–å›è°ƒ
  // ==========================================================================

  /** å±å¹•æ–­ç‚¹å˜åŒ–æ—¶ï¼Œæ›´æ–°å®‰å…¨åŒºåŸŸå¹¶ä¼ é€’ç»™ Native å±‚ */
  breakPointChange() {
    this.cutoutAreas.heightBreakpoint = this.heightBreakpoint;
    this.cutoutAreas.widthBreakpoint = this.widthBreakpoint;
    tetrahedron_napi.objectPassing(this.cutoutAreas);
  }

  /** å®‰å…¨åŒºåŸŸ (åˆ˜æµ·/å¯¼èˆªæ ) å˜åŒ–æ—¶é‡æ–°è®¡ç®— */
  cutoutChange() {
    let topPX = getTop(this.avoidAreas);
    let rightPX = getRight(this.avoidAreas, this.windowWidth);
    let bottomPX = getBottom(this.avoidAreas, this.windowHeight);
    let leftPX = getLeft(this.avoidAreas);

    this.cutoutAreas = {
      top: topPX, right: rightPX, bottom: bottomPX, left: leftPX,
      heightBreakpoint: this.heightBreakpoint, widthBreakpoint: this.widthBreakpoint
    };

    this.localPadding = {
      top: LengthMetrics.px(topPX),
      end: LengthMetrics.px(rightPX),
      bottom: LengthMetrics.px(bottomPX),
      start: LengthMetrics.px(leftPX)
    };
    tetrahedron_napi.objectPassing(this.cutoutAreas);
  }

  // ==========================================================================
  // ç”Ÿå‘½å‘¨æœŸ
  // ==========================================================================

  /** é¡µé¢å³å°†æ˜¾ç¤º â€” åˆå§‹åŒ–æ—‹è½¬è§’åº¦å’Œå®‰å…¨åŒºåŸŸ */
  async aboutToAppear() {
    Logger.info('aboutToAppear');
    this.angleArray[0] = 30;  // åˆå§‹ X è½´ 30Â°
    this.angleArray[1] = 45;  // åˆå§‹ Y è½´ 45Â°

    let topPX = getTop(this.avoidAreas);
    let rightPX = getRight(this.avoidAreas, this.windowWidth);
    let bottomPX = getBottom(this.avoidAreas, this.windowHeight);
    let leftPX = getLeft(this.avoidAreas);

    this.cutoutAreas = {
      top: topPX, right: rightPX, bottom: bottomPX, left: leftPX,
      heightBreakpoint: this.heightBreakpoint, widthBreakpoint: this.widthBreakpoint
    };

    this.localPadding = {
      top: LengthMetrics.px(topPX),
      end: LengthMetrics.px(rightPX),
      bottom: LengthMetrics.px(bottomPX),
      start: LengthMetrics.px(leftPX)
    };

    tetrahedron_napi.objectPassing(this.cutoutAreas);
  }

  /**
   * é¡µé¢æ˜¾ç¤ºå›è°ƒ â€” å¤„ç†ä»æ¨¡å‹é€‰æ‹©/å‚æ•°ç¼–è¾‘é¡µè¿”å›çš„è·¯ç”±å‚æ•°
   *
   * å½“ä» ModelSelectPage æˆ– ParamEditPage è¿”å›æ—¶ï¼Œ
   * router.getParams() ä¼šåŒ…å« shapeType å’Œå¯é€‰çš„ shapeParamsã€‚
   * è°ƒç”¨ applyShapeSelection() é€šçŸ¥ Native å±‚åˆ‡æ¢æ¨¡å‹ã€‚
   */
  onPageShow(): void {
    Logger.info('onPageShow');
    let params = router.getParams() as RouteResult;
    if (params && params.shapeType !== undefined) {
      this.applyShapeSelection(params.shapeType, params.shapeParams);
      // æ¸…é™¤è·¯ç”±å‚æ•°ï¼Œé¿å…ä¸‹æ¬¡ onPageShow é‡å¤æ‰§è¡Œ
      router.clear();
    }
  }

  /**
   * åº”ç”¨æ¨¡å‹é€‰æ‹©ç»“æœ
   *
   * æµç¨‹ï¼š
   *   1. è°ƒç”¨ NAPI selectShape åˆ‡æ¢åˆ°æŒ‡å®šæ¨¡å‹
   *   2. å¦‚æœæœ‰è‡ªå®šä¹‰å‚æ•°ï¼Œè°ƒç”¨ NAPI setShapeParams åº”ç”¨
   *   3. æ›´æ–°å·¦ä¸Šè§’çš„æ¨¡å‹åç§°æ˜¾ç¤º
   */
  applyShapeSelection(shapeType: number, shapeParams: ShapeParams | null): void {
    Logger.info('applyShapeSelection type=' + shapeType);

    // é€šçŸ¥ Native å±‚åˆ‡æ¢å‡ ä½•ä½“
    tetrahedron_napi.selectShape(shapeType);

    // å¦‚æœæœ‰è‡ªå®šä¹‰å‚æ•°ï¼ˆæ¥è‡ª ParamEditPageï¼‰ï¼ŒåŒæ­¥åº”ç”¨
    if (shapeParams !== null) {
      tetrahedron_napi.setShapeParams(shapeParams);
    }

    // æ›´æ–° UI æ˜¾ç¤ºçš„æ¨¡å‹åç§°
    let names = [
      'å››é¢ä½“', 'çƒä½“', 'æ­£æ–¹ä½“', 'åœ†é”¥',
      'æ¤­çƒé¢', 'å•å¶åŒæ›²é¢', 'æ¤­åœ†æŠ›ç‰©é¢', 'æ¤­åœ†é”¥é¢'
    ];
    if (shapeType >= 0 && shapeType < names.length) {
      this.currentShapeName = names[shapeType];
    }
  }

  // ==========================================================================
  // é¡µé¢æ„å»º
  // ==========================================================================

  build() {
    Stack({ alignContent: Alignment.Bottom }) {
      Column() {
        Column() {
          // ==============================================================
          // XComponent â€” OpenGL ES æ¸²æŸ“è¡¨é¢
          // ==============================================================
          XComponent({
            id: this.xComponentId,
            type: XComponentType.SURFACE,          // æ¸²æŸ“è¡¨é¢æ¨¡å¼
            libraryname: 'tetrahedron_napi'        // å¯¹åº”çš„ .so åç§°
          })
            .onLoad(() => {
              Logger.info('onLoad');
            })
            .id('tetrahedron')
            .onDestroy(() => {
              Logger.info('onDestroy');
            })
            .id('xComponent')
            .backgroundColor('#FFFFFF')
        }
        .justifyContent(FlexAlign.SpaceAround)
        .alignItems(HorizontalAlign.Center)
        .height('100%')
        .width('100%')
        .backgroundColor('#FFFFFF')
        .borderRadius(24)
      }
      // ==================================================================
      // æ‰‹åŠ¿è¯†åˆ« â€” å…¨æ–¹å‘æ‹–æ‹½æ—‹è½¬
      // ==================================================================
      .gesture(
        PanGesture(this.panOption)
          .onActionStart(() => {
            Logger.info('Gesture onActionStart');
          })
          .onActionUpdate((event: GestureEvent) => {
            // æ‰‹åŠ¿æ‹–æ‹½æ—¶åœæ­¢è‡ªåŠ¨æ—‹è½¬
            tetrahedron_napi.setRotate(RotationType.STOP);
            this.enableRotate = false;
            // å°†æ‰‹åŠ¿åç§»ä¼ é€’ç»™ Native å±‚æ›´æ–°è§’åº¦
            this.angleArray = tetrahedron_napi.updateAngle(event.offsetX, event.offsetY);
            Logger.info('Gesture onActionUpdate : offSet ' + event.offsetX + ',' + event.offsetY);
          })
          .onActionEnd(() => {
            Logger.info('Gesture onActionEnd');
          })
      )
      .height('100%')
      .justifyContent(FlexAlign.SpaceBetween)

      // ==================================================================
      // å·¦ä¸Šè§’ â€” æ¨¡å‹åˆ‡æ¢æŒ‰é’®
      // ==================================================================
      Row() {
        Button() {
          Row({ space: 6 }) {
            Text('\u2630')              // â˜° èœå•å›¾æ ‡
              .fontSize(18)
              .fontColor('#FFFFFF')
            Text('æ¨¡å‹')
              .fontSize(14)
              .fontColor('#FFFFFF')
              .fontWeight(FontWeight.Medium)
          }
        }
        .type(ButtonType.Capsule)       // èƒ¶å›Šå½¢çŠ¶
        .backgroundColor('#80000000')   // åŠé€æ˜é»‘è‰²èƒŒæ™¯
        .borderRadius(20)
        .onClick(() => {
          // è·³è½¬åˆ°æ¨¡å‹é€‰æ‹©é¡µé¢
          router.pushUrl({ url: 'pages/ModelSelectPage' });
        })
      }
      .width('100%')
      .justifyContent(FlexAlign.Start)  // å·¦å¯¹é½
      .padding({ left: 16, top: 16 })
      .hitTestBehavior(HitTestMode.Transparent)  // ä¸æ‹¦æˆªè§¦æ‘¸äº‹ä»¶
      .position({ x: 0, y: 0 })        // ç»å¯¹å®šä½åœ¨å·¦ä¸Šè§’
      .zIndex(10)                       // ç¡®ä¿åœ¨æœ€ä¸Šå±‚

      // ==================================================================
      // å·¦ä¸Šè§’ â€” å½“å‰æ¨¡å‹åç§°æŒ‡ç¤ºå™¨
      // ==================================================================
      Text('å½“å‰: ' + this.currentShapeName)
        .fontSize(11)
        .fontColor('#99FFFFFF')
        .backgroundColor('#40000000')
        .borderRadius(10)
        .padding({ left: 10, right: 10, top: 4, bottom: 4 })
        .position({ x: 16, y: 56 })
        .zIndex(10)

      // ==================================================================
      // ç¼©æ”¾æ»‘å—
      // ==================================================================
      Row() {
        Text('ç¼©å°')
          .fontSize(11)
          .fontColor('#999999')
          .margin({ right: 8 })

        Slider({
          value: this.modelScale,
          min: 0.3,       // æœ€å°ç¼©æ”¾ 30%
          max: 2.5,       // æœ€å¤§ç¼©æ”¾ 250%
          step: 0.05,     // æ­¥é•¿ 5%
          style: SliderStyle.InSet
        })
          .showTips(true)           // æ‹–åŠ¨æ—¶æ˜¾ç¤ºæ•°å€¼
          .trackColor('#40000000')  // æœªå¡«å……è½¨é“é¢œè‰²
          .selectedColor('#FFFFFF') // å·²å¡«å……è½¨é“é¢œè‰²
          .layoutWeight(1)          // å æ®å‰©ä½™å®½åº¦
          .onChange((value: number) => {
            this.modelScale = value;
            // å®æ—¶é€šçŸ¥ Native å±‚æ›´æ–°ç¼©æ”¾
            tetrahedron_napi.setScale(value);
          })

        Text('æ”¾å¤§')
          .fontSize(11)
          .fontColor('#999999')
          .margin({ left: 8 })
      }
      .width('100%')
      .padding({ left: 24, right: 24 })
      .hitTestBehavior(HitTestMode.Transparent)  // ä¸æ‹¦æˆªåº•å±‚æ‰‹åŠ¿

      // ==================================================================
      // åº•éƒ¨ â€” æ—‹è½¬æ¨¡å¼æŒ‰é’®
      // ==================================================================
      Row({ space: 12 }) {
        // ã€Œè‡ªåŠ¨æ—‹è½¬ / åœæ­¢ã€æŒ‰é’® â€” åˆ‡æ¢è‡ªåŠ¨æ—‹è½¬çŠ¶æ€
        Button(this.enableRotate ? $r('app.string.btn_stop_rotation') : $r('app.string.btn_auto_rotation'),
          { type: ButtonType.Capsule, stateEffect: true })
          .fontSize(16)
          .onClick(() => {
            if (this.enableRotate) {
              // å½“å‰æ­£åœ¨è‡ªåŠ¨æ—‹è½¬ â†’ åœæ­¢
              tetrahedron_napi.setRotate(RotationType.STOP);
              this.enableRotate = false;
            } else {
              // å½“å‰é™æ­¢ â†’ å¼€å§‹è‡ªåŠ¨æ—‹è½¬
              tetrahedron_napi.setRotate(RotationType.AUTO);
              this.enableRotate = true;
            }
          })
          .layoutWeight(1)

        // ã€Œé˜»å°¼æ—‹è½¬ã€æŒ‰é’® â€” æ‰‹åŠ¿é‡Šæ”¾åæƒ¯æ€§å‡é€Ÿ
        Button($r('app.string.btn_damping_rotation'), { type: ButtonType.Capsule, stateEffect: true })
          .fontSize(16)
          .onClick(() => {
            this.enableRotate = false;
            tetrahedron_napi.setRotate(RotationType.DAMPING);
          })
          .layoutWeight(1)
      }
      .hitTestBehavior(HitTestMode.Transparent)
      .padding({
        left: this.widthBreakpoint === WidthBreakpoint.WIDTH_SM ? 12 : 24,
        right: this.widthBreakpoint === WidthBreakpoint.WIDTH_SM ? 12 : 24,
        bottom: 50
      })
    }
    .padding(this.localPadding)  // åº”ç”¨å®‰å…¨åŒºåŸŸå†…è¾¹è·
