            case ShapeType.PARAMETRIC_PARABOLOID:
                // æ¤­åœ†æŠ›ç‰©é¢: z = xÂ²/aÂ² + yÂ²/bÂ²
                return 'z = x\u00B2/' + this.paramA.toFixed(1) + '\u00B2 + y\u00B2/' +
                    this.paramB.toFixed(1) + '\u00B2';
