            case ShapeType.PARAMETRIC_HYPERBOLOID:
                // å•å¶åŒæ›²é¢: xÂ²/aÂ² + yÂ²/bÂ² âˆ’ zÂ²/cÂ² = 1
                return 'x\u00B2/' + this.paramA.toFixed(1) + '\u00B2 + y\u00B2/' +
