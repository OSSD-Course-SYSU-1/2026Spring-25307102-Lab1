     */
    getEquationText() {
        switch (this.shapeType) {
            case ShapeType.PARAMETRIC_ELLIPSOID:
                // æ¤­çƒé¢: xÂ²/aÂ² + yÂ²/bÂ² + zÂ²/cÂ² = 1
